{
  "name": "tubecraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:showcase": "vite --config vite.showcase.config.ts",
    "build:showcase": "tsc --noEmit -p tsconfig.showcase.json && vite build --config vite.showcase.config.ts",
    "preview:showcase": "vite preview --config vite.showcase.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.showcase.json",
    "catalog": "node scripts/build-catalog.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^4.1.12"
  }
}
