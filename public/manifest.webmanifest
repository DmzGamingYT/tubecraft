{
  "id": "./",
  "name": "TubeCraft",
  "short_name": "TubeCraft",
  "description": "Un client YouTube open source : recherche, lecteur, Shorts, abonnements et commentaires. Sans clé API, données locales.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f0f0f",
  "theme_color": "#0f0f0f",
  "categories": ["entertainment", "video", "multimedia"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Rechercher",
      "short_name": "Recherche",
      "url": "./search",
      "description": "Chercher une vidéo sur YouTube"
    },
    {
      "name": "Shorts",
      "short_name": "Shorts",
      "url": "./shorts",
      "description": "Ouvrir le fil vertical"
    },
    {
      "name": "Lire ensuite",
      "short_name": "Lire ensuite",
      "url": "./queue",
      "description": "Reprendre la file personnelle"
    },
    {
      "name": "Ma bibliothèque",
      "short_name": "Bibliothèque",
      "url": "./playlists",
      "description": "Playlists et vidéos enregistrées"
    }
  ]
}
